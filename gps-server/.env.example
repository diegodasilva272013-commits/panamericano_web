# Copiar a .env en el servidor (VPS) y completar. NUNCA subir el .env real al repositorio.

# Base de datos (Supabase). La clave de servicio da acceso total: solo vive en este servidor.
SUPABASE_URL=https://fgtwsnjbieyzdfwvlhgo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Puertos donde escuchan los equipos (los mismos que se configuran en cada Rinho). UDP y TCP pueden usar el mismo número.
UDP_PORT=4031
TCP_PORT=4031

# Control del checksum de las tramas entrantes:
#   warn   = avisa en el registro pero acepta (recomendado hasta probar el primer equipo real)
#   strict = descarta las que no coinciden (activar cuando el registro muestre que badChecksum es siempre 0)
CHECKSUM=warn

# Opcionales
# HEALTH_PORT=8081          # estado en http://127.0.0.1:8081 (solo desde el propio servidor); "off" para apagar
# FLUSH_MS=500              # cada cuánto se guardan los reportes en lote
# CONFIG_REFRESH_S=30       # cada cuánto relee vehículos, geocercas y viajes
# MAX_FRAMES_PER_SEC=200    # freno de ráfagas por dirección de origen
